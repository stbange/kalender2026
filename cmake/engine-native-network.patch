+static bool parse_ws_url(const char *url, uint16_t fallback_port, eng_net_peer_t *peer,
+                         uint16_t *port_out, bool *is_wss) {
+    if (strpbrk(url, " \t\r\n#")) return false;
+    const char *authority = url;
+    *is_wss = strncmp(url, "wss://", 6) == 0;
+    if (*is_wss) authority += 6;
+    else if (!strncmp(url, "ws://", 5)) authority += 5;
+    uint16_t port = fallback_port ? fallback_port : (*is_wss ? 443 : authority != url ? 80 : 7777);
+
+    const char *end = authority + strcspn(authority, "/?");
+    size_t len = (size_t)(end - authority);
+    if (!len || len >= sizeof(peer->ws_authority) || memchr(authority, '@', len)) return false;
+    const char *host = authority, *host_end, *suffix;
+    if (*host == '[') {
+        host++;
+        host_end = memchr(host, ']', (size_t)(end - host));
+        if (!host_end) return false;
+        suffix = host_end + 1;
+    } else {
+        host_end = memchr(host, ':', len);
+        if (!host_end) host_end = end;
+        suffix = host_end;
+    }
+    size_t host_len = (size_t)(host_end - host);
+    if (!host_len || host_len >= sizeof(peer->ws_host)) return false;
+    if (suffix < end) {
+        if (*suffix++ != ':' || suffix == end) return false;
+        unsigned value = 0;
+        for (; suffix < end; suffix++) {
+            if (*suffix < '0' || *suffix > '9') return false;
+            value = value * 10u + (unsigned)(*suffix - '0');
+            if (value > 65535u) return false;
+        }
+        if (!value) return false;
+        port = (uint16_t)value;
+    }
+    memcpy(peer->ws_authority, authority, len);
+    peer->ws_authority[len] = '\0';
+    memcpy(peer->ws_host, host, host_len);
+    peer->ws_host[host_len] = '\0';
+    int n = snprintf(peer->ws_path, sizeof(peer->ws_path), "%s%s", *end == '/' ? "" : "/", end);
+    if (n < 0 || (size_t)n >= sizeof(peer->ws_path)) return false;
+    *port_out = port;
+    return true;
 }

