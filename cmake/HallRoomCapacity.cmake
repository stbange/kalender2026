# The engine publishes its peer capacity as a header constant. Provide the same
# public headers to engine and game, with space for six eight-player hall rooms.
set(hall_include "${CMAKE_CURRENT_BINARY_DIR}/hall-include")
file(GLOB engine_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/engine/include/engine/*.h")
foreach(header IN LISTS engine_headers)
    get_filename_component(name "${header}" NAME)
    set(output "${hall_include}/engine/${name}")
    if(name STREQUAL "eng_net.h")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}")
        file(READ "${header}" declarations)
        string(REGEX REPLACE "(#define ENG_NET_MAX_CLIENTS) [0-9]+" "\\1 48" declarations "${declarations}")
        file(GENERATE OUTPUT "${output}" CONTENT "${declarations}")
    else()
        configure_file("${header}" "${output}" COPYONLY)
    endif()
endforeach()
target_include_directories(libengine BEFORE PUBLIC "${hall_include}")
