[Unit]
Description=Kalender 2026 Lantern Hall room service
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/lantern
ExecStart=/opt/lantern/lantern --serve --port 8787
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
